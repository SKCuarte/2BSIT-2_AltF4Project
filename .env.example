DB_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hope_dev
DB_USER=hope_app
DB_PASSWORD=replace_with_your_local_password
DB_SSL=false

# Required only for npm run db:reset. Use a local PostgreSQL administrator.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=replace_with_your_local_admin_password

# Optional comma-separated hosts approved for development reset.
# A remote host must be listed here AND DB_ENV must be development.
DB_ALLOWED_DEV_HOSTS=