DB_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hope_dev
DB_USER=hope_app
DB_PASSWORD=replace_with_your_local_password
DB_SSL=false

# Required only for npm run db:reset. Use a local PostgreSQL administrator.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=replace_with_your_local_admin_password

# Setup-link scripts (db:seed:team, db:setup-links). Server-side only; never commit real values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
APP_BASE_URL=http://localhost:3000

# Optional comma-separated hosts approved for development migrations and reset.
# Allowlist only verified DEV endpoints; shared poolers can also serve production.
# Remote migrations also require DB_SSL=true.
DB_ALLOWED_DEV_HOSTS=
# Remote migrations only: exact lowercase DB_HOST/DB_NAME/DB_USER of the intended DEV target.
DB_CONFIRM_DEV_PROJECT=