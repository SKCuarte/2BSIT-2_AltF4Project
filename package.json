{
  "name": "hope-inc-erp-database",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform PostgreSQL migration and seed tools for Hope, Inc. ERP",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "db:migrate": "node db/scripts/db.js migrate",
    "db:status": "node db/scripts/db.js status",
    "db:reset": "node db/scripts/db.js reset",
    "db:seed": "node db/scripts/seed.js",
    "db:seed:team": "node db/scripts/seed-team.js",
    "db:seed:team:web": "node db/scripts/seed-team-api.js --env-file web/.env.local",
    "db:seed:dev": "node db/scripts/seed-dev-users.js",
    "db:setup-links": "node db/scripts/issue-setup-links.js",
    "db:setup-links:web": "node db/scripts/issue-setup-links.js --env-file web/.env.local",
    "check:secrets": "node db/scripts/check-sql-secrets.js"
  },
  "dependencies": {
    "dotenv": "16.4.7",
    "pg": "8.13.1"
  }
}