NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# Server-only values. Never expose secret keys to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:5432/postgres?sslmode=verify-full
DATABASE_SSL=true
# Download the project's CA certificate from Supabase Database settings and save it outside Git.
DATABASE_SSL_ROOT_CERT=certs/supabase-ca.crt
APP_BASE_URL=http://localhost:3000
